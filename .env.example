# Mapbox GL access token (public key, starts with "pk.").
# Get one free at https://account.mapbox.com/access-tokens/
# If omitted, the app falls back to a token-free Esri World Imagery basemap.
VITE_MAPBOX_TOKEN=

# Inference backend base URL (FastAPI). Defaults to http://localhost:8000.
VITE_API_URL=http://localhost:8000
